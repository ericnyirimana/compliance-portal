{
  "info": {
    "_postman_id": "bnr-licensing-portal-v1",
    "name": "BNR Licensing Portal API",
    "description": "National Bank of Rwanda — Licensing & Compliance Portal. Import this collection alongside the BNR Licensing Portal environment which defines {{baseUrl}} and {{accessToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentSlot",
      "value": "business_plan",
      "type": "string"
    },
    {
      "key": "versionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Server health check — no authentication required.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns server status and current timestamp. No authentication required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints — register, login, token refresh, and logout.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "  pm.test('Registration successful', () => pm.response.to.have.status(201));",
                  "  pm.test('Access token returned', () => pm.expect(json.accessToken).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"applicant@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new APPLICANT account. Automatically saves accessToken and refreshToken to collection variables on success."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "  pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "  pm.test('Token pair returned', () => {",
                  "    pm.expect(json.accessToken).to.be.a('string');",
                  "    pm.expect(json.refreshToken).to.be.a('string');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"applicant@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with email and password. Automatically saves the returned token pair to collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "  pm.test('Token rotated', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Exchange a refresh token for a new token pair (rotation). The old refresh token is invalidated."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logged out', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Invalidate the refresh token server-side. Clears stored tokens from collection variables on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Applications",
      "description": "Lifecycle management for licence applications — create, submit, review, decide.",
      "item": [
        {
          "name": "List Applications",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            },
            "description": "Returns own applications for APPLICANT role; returns all applications for REVIEWER, DECISION_MAKER, and ADMIN roles."
          },
          "response": []
        },
        {
          "name": "Create Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('applicationId', json.id);",
                  "  pm.test('Application created', () => pm.response.to.have.status(201));",
                  "  pm.test('Status is DRAFT', () => pm.expect(json.status).to.equal('DRAFT'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankName\": \"Kigali Commercial Bank\",\n  \"licenceType\": \"COMMERCIAL_BANK\",\n  \"capitalAmount\": 5000000,\n  \"address\": \"KG 100 St, Kigali, Rwanda\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            },
            "description": "Create a new licence application in DRAFT status. Requires APPLICANT role. Saves the new application ID to collection variables."
          },
          "response": []
        },
        {
          "name": "Get Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            },
            "description": "Retrieve a single application by its UUID. Returns 404 if not found or not accessible to the caller."
          },
          "response": []
        },
        {
          "name": "Submit Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Application submitted', () => pm.response.to.have.status(201));",
                  "  pm.test('Status is SUBMITTED', () => pm.expect(json.status).to.equal('SUBMITTED'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "submit"]
            },
            "description": "Transition a DRAFT application to SUBMITTED. Only the owning APPLICANT may call this. Returns 409 on invalid state transition or optimistic-lock conflict."
          },
          "response": []
        },
        {
          "name": "Pickup Application (Reviewer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Application picked up', () => pm.response.to.have.status(201));",
                  "  pm.test('Status is UNDER_REVIEW', () => pm.expect(json.status).to.equal('UNDER_REVIEW'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/pickup",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "pickup"]
            },
            "description": "A REVIEWER picks up a SUBMITTED application for review. Uses optimistic locking — returns 409 STALE_VERSION if another reviewer picked it up concurrently."
          },
          "response": []
        },
        {
          "name": "Request Additional Info (Reviewer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Please provide audited financial statements for the last three years and updated shareholder register.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/request-info",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "request-info"]
            },
            "description": "REVIEWER returns the application to the applicant for additional information. Transitions status to RETURNED_FOR_INFO. Notes field must be at least 10 characters."
          },
          "response": []
        },
        {
          "name": "Recommend for Decision (Reviewer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"All documentation is in order. Capital requirements met. Recommend approval.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/recommend",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "recommend"]
            },
            "description": "REVIEWER forwards the application to a DECISION_MAKER by transitioning status to PENDING_DECISION. Notes are optional."
          },
          "response": []
        },
        {
          "name": "Resubmit Application (Applicant)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/resubmit",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "resubmit"]
            },
            "description": "APPLICANT resubmits an application that is in RETURNED_FOR_INFO status after uploading the requested documents."
          },
          "response": []
        },
        {
          "name": "Decide Application (Decision Maker)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"notes\": \"Application meets all regulatory requirements. Licence granted effective immediately.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/decide",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "decide"]
            },
            "description": "DECISION_MAKER issues a final APPROVED or REJECTED verdict on a PENDING_DECISION application. The reviewer who handled the application cannot be the decision maker (separation of duties)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "description": "Document upload and retrieval for licence applications.",
      "item": [
        {
          "name": "List Document Slots",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "documents"]
            },
            "description": "List all document slots that have been used for this application. Each slot can hold multiple versions."
          },
          "response": []
        },
        {
          "name": "List Document Versions",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/documents/{{documentSlot}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "documents", "{{documentSlot}}"]
            },
            "description": "List all versions uploaded to a specific document slot. The slot name (e.g. 'business_plan', 'audited_accounts') identifies the document type."
          },
          "response": []
        },
        {
          "name": "Upload Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('versionId', json.id);",
                  "  pm.test('Document uploaded', () => pm.response.to.have.status(201));",
                  "  pm.test('Version number set', () => pm.expect(json.versionNumber).to.be.a('number'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Select a file to upload (PDF, PNG, JPG accepted; max 5 MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/documents/{{documentSlot}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "documents", "{{documentSlot}}"]
            },
            "description": "Upload a file to a document slot. If the slot already has a document, a new version is created automatically. Max file size is 5 MB. Saves returned version ID to collection variables."
          },
          "response": []
        },
        {
          "name": "Download Document Version",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/documents/{{documentSlot}}/versions/{{versionId}}/download",
              "host": ["{{baseUrl}}"],
              "path": [
                "applications",
                "{{applicationId}}",
                "documents",
                "{{documentSlot}}",
                "versions",
                "{{versionId}}",
                "download"
              ]
            },
            "description": "Download a specific document version as a binary stream. Authentication required. The response Content-Type matches the originally uploaded file's MIME type."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audit",
      "description": "Tamper-evident audit log with SHA-256 hash chain verification.",
      "item": [
        {
          "name": "Verify Hash Chain",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit/verify",
              "host": ["{{baseUrl}}"],
              "path": ["audit", "verify"]
            },
            "description": "Walk the entire audit log and verify the SHA-256 hash chain is unbroken. Returns the total row count and, if invalid, the UUID and position of the first tampered entry."
          },
          "response": []
        },
        {
          "name": "Get Audit Log for Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit/applications/{{applicationId}}?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["audit", "applications", "{{applicationId}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Max entries to return (default 50)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset (default 0)"
                }
              ]
            },
            "description": "Retrieve paginated audit entries scoped to a specific application. Each entry includes the actor, action, state transition, and row hash."
          },
          "response": []
        },
        {
          "name": "Get All Audit Entries",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit?limit=100&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["audit"],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Max entries to return (default 100)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset (default 0)"
                }
              ]
            },
            "description": "Retrieve all audit log entries across the system (paginated). Accessible to ADMIN, REVIEWER, and DECISION_MAKER roles."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "description": "User management — ADMIN role required for all endpoints.",
      "item": [
        {
          "name": "List Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "List all registered users. Requires ADMIN role. Returns 403 for any other role."
          },
          "response": []
        },
        {
          "name": "Toggle User Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "status"]
            },
            "description": "Activate (isActive: true) or deactivate (isActive: false) a user account. Deactivated users cannot authenticate. Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "Set User Role",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"REVIEWER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/role",
              "host": ["{{baseUrl}}"],
