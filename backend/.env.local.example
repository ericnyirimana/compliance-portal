# Backend environment for running without Docker.
# Copy to backend/.env and fill in your local Postgres credentials.

# --- Postgres connections ---
# bnr_owner is used only by migrations (DDL privileges)
DATABASE_OWNER_URL=postgres://bnr_owner:changeme_owner@localhost:5432/bnr_licensing

# bnr_app is the runtime role (limited SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL=postgres://bnr_app:changeme_app@localhost:5432/bnr_licensing

# --- JWT ---
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=changeme_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- App ---
NODE_ENV=development
PORT=3000
STORAGE_PATH=./storage
