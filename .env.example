# Copy to .env and fill in values before running docker compose

# Postgres
POSTGRES_OWNER_PASSWORD=changeme_owner
POSTGRES_APP_PASSWORD=changeme_app

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=changeme_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_min_32_chars

# App
NODE_ENV=development
PORT=3000
STORAGE_PATH=./storage
